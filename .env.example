# Async database connection string (e.g. sqlite+aiosqlite:///Airiva.db or postgresql+asyncpg://...)
DATABASE_URL=

# PostgreSQL database username
POSTGRES_USER=

# PostgreSQL database user password
POSTGRES_PASSWORD=

# PostgreSQL database name
POSTGRES_DB=

# PostgreSQL database server host
POSTGRES_HOST=

# PostgreSQL database server port
POSTGRES_PORT=

# PgAdmin administrative console email address
PGADMIN_EMAIL=

# PgAdmin administrative console password
PGADMIN_PASSWORD=

# Redis cache and distributed task queue connection URL
REDIS_URL=

# Local directory path for storing raw scraper JSON/HTML dumps
RAW_DATA_DIR=

# File path to DGCA route passenger traffic weights CSV
WEIGHTS_FILE=

# Directory path containing DGCA Table 4.3 monthly PDF reports
DGCA_PDF_DIR=

# File path to baseline synthetic fare quotes CSV
SEED_FILE=

# Cron schedule expression for daily scraper execution (UTC)
COLLECTION_CRON=

# Minimum randomized polite delay between scraper requests in seconds
SCRAPER_MIN_DELAY_S=

# Maximum randomized polite delay between scraper requests in seconds
SCRAPER_MAX_DELAY_S=

# Browser engine for Playwright automation (chromium, firefox, webkit)
PLAYWRIGHT_BROWSER=

# Whether Playwright runs in headless mode (true or false)
PLAYWRIGHT_HEADLESS=

# Comma-separated list of active scraper sources (indigo, air_india, makemytrip, akasa, spicejet)
ENABLED_SOURCES=

# Fastapi / Uvicorn server bind address
API_HOST=

# Fastapi / Uvicorn server listening port
API_PORT=

# Logging level verbosity (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=
